# =================================================================
# PIE MC BACKEND MASTER CONFIGURATION
# =================================================================

# Server Listening Port
PORT=8082

# Master Backend API Key (Bearer Token - Restricted to Platform Owner)
PIE_MC_API_KEY=pie_mc_live_89437b02c89f4172

# Session Secret
SESSION_SECRET=pie_mc_super_secret_session_key_9981274

# =================================================================
# DISCORD OAUTH2 AUTHENTICATION
# =================================================================
# Obtain these from the Discord Developer Portal (https://discord.com/developers/applications)

DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_REDIRECT_URI=http://localhost:8082/api/auth/callback

# Platform Owner Discord ID (Grants Admin Panel & API Key Management)
OWNER_DISCORD_ID=987654321098765432

# =================================================================
# TRI-MODE DATABASE STORAGE ENGINE
# Choose one of: 'sqlite' | 'local_json' | 'turso'
# =================================================================
DATABASE_MODE=sqlite

# Mode 1: SQLite Path
SQLITE_DB_PATH=backend/data/pie-mc.db

# Mode 2: Local JSON Store Directory
JSON_STORE_PATH=backend/data/json_store/

# Mode 3: Turso Cloud Database (libSQL)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# =================================================================
# OWNER PLATFORM FEATURE TOGGLES (DEFAULT SETTINGS)
# =================================================================
ALLOW_USER_CHANGE_VERSION=true
GLOBAL_LOCKED_VERSION=1.21.1
ALLOW_AUTO_RECONNECT=true
ALLOW_NEW_REGISTRATIONS=true
